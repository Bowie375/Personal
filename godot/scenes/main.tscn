[gd_scene load_steps=4 format=3 uid="uid://robot_forge_main"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_main"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.08, 0.1, 0.12, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.2, 0.22, 0.25, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn"]
bg_color = Color(0.15, 0.2, 0.25, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.3, 0.5, 0.8, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_main")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -180.0
offset_right = 220.0
offset_bottom = 180.0

[node name="Title" type="Label" parent="VBox"]
text = "Robot Forge"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 36

[node name="Subtitle" type="Label" parent="VBox"]
text = "Build a robot from gears to manipulation"
horizontal_alignment = 1
modulate = Color(1, 1, 1, 0.7)

[node name="Spacer" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 20)

[node name="Levels" type="VBoxContainer" parent="VBox"]

[node name="Spacer2" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 12)

[node name="Status" type="Label" parent="VBox"]
text = "Profile: ~/.local/share/robot-forge/profile.json"
horizontal_alignment = 1
modulate = Color(1, 1, 1, 0.5)
autowrap_mode = 2
